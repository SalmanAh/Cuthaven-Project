# Points the frontend at the separately-running backend (see /backend).
# Never used for direct DB access — the frontend only ever talks to this API.
VITE_API_URL=http://localhost:4000/api

# Stripe publishable key — safe to expose to the browser (pk_test_... or pk_live_...)
# Get from https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here
