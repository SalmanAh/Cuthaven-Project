# Points the frontend at the separately-running backend (see /backend).
# Never used for direct DB access — the frontend only ever talks to this API.
VITE_API_URL=http://localhost:4000/api

# Public-facing store URL — used in JSON-LD structured data and the sitemap.
# Dev:  http://localhost:8080
# Prod: https://www.cuthaven.com
VITE_STORE_URL=http://localhost:8080

# ═══════════════════════════════════════════════════════════════════════════
# ⚠️  IMPORTANT: Payment Gateway Keys are Managed in the Database
# ═══════════════════════════════════════════════════════════════════════════
# DO NOT add VITE_STRIPE_PUBLISHABLE_KEY or VITE_PAYPAL_CLIENT_ID here.
# 
# The checkout page dynamically fetches active payment gateway configurations
# from the backend API at runtime via GET /api/checkout/active-gateways
#
# To configure payment gateways:
# 1. Log in to Admin Panel (http://localhost:8080/admin)
# 2. Navigate to Payment Gateways section (/admin/payment-gateways)
# 3. Add/activate Stripe and/or PayPal credentials
# 4. Changes take effect immediately on next checkout page load
#
# This architecture allows:
# - Zero-downtime payment gateway updates
# - Multiple Stripe/PayPal accounts with instant switching
# - Admin can manage without developer/deployment access
# ═══════════════════════════════════════════════════════════════════════════
