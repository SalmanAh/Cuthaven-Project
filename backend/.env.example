# Backend server
PORT=4000
NODE_ENV=development

# CORS — the frontend's own dev URL, so the browser is allowed to call this API
FRONTEND_ORIGIN=http://localhost:8080

# Your own Supabase project (NOT Lovable Cloud) — from Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Service role key — full DB access, bypasses RLS. Server-only. NEVER send to the frontend,
# NEVER commit this file with a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
