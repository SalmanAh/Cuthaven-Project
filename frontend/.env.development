# DO NOT add:
#   - VITE_STRIPE_PUBLISHABLE_KEY
#   - VITE_PAYPAL_CLIENT_ID
#
# The checkout page dynamically loads keys from the backend API.
# This ensures admin can switch payment gateways without redeploying.
