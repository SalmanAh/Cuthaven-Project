# PRODUCTION ENVIRONMENT CONFIGURATION
# Use this file on your live VPS server

# Points the frontend at the production backend API
VITE_API_URL=https://api.cuthaven.com/api

# Store URL for JSON-LD and sitemap
VITE_STORE_URL=https://www.cuthaven.com

# ═══════════════════════════════════════════════════════════════════════════
# ⚠️ PAYMENT GATEWAY KEYS — DO NOT ADD HERE!
# ═══════════════════════════════════════════════════════════════════════════
# Payment keys are managed in the DATABASE (payment_gateways table).
# Frontend fetches them via: GET /api/checkout/active-gateways
# 
# DO NOT add:
#   - VITE_STRIPE_PUBLISHABLE_KEY
#   - VITE_PAYPAL_CLIENT_ID
#
# The checkout page dynamically loads keys from the backend API.
# This ensures admin can switch payment gateways without redeploying.
# ═══════════════════════════════════════════════════════════════════════════
