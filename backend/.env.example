# ═══════════════════════════════════════════════════════════════════════════
# CutHaven Backend — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# ═══════════════════════════════════════════════════════════════════════════

# ── Server ─────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development   # Change to "production" on your server

# ── CORS ───────────────────────────────────────────────────────────────────
# The exact origin of the frontend — no trailing slash.
# Dev:  http://localhost:8080
# Prod: https://www.cuthaven.com
FRONTEND_ORIGIN=http://localhost:8080

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings > API in your Supabase dashboard.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Service role key — bypasses RLS, full DB access.
# ⚠️  Server-only. NEVER expose to the frontend or commit this file with a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Store ───────────────────────────────────────────────────────────────────
# Public-facing store URL — used for product links in the GMC feed.
# Dev:  http://localhost:8080
# Prod: https://www.cuthaven.com
STORE_URL=http://localhost:8080

# ── PayPal ──────────────────────────────────────────────────────────────────
# Get from https://developer.paypal.com/dashboard/applications
# Client ID (public — safe to expose to browser)
# Use sandbox app for dev, live app for production.
PAYPAL_CLIENT_ID=your-paypal-client-id-here
PAYPAL_CLIENT_SECRET=your-paypal-client-secret-here
PAYPAL_MODE=sandbox   # Change to "live" for production

# ── Resend (transactional email) ────────────────────────────────────────────
# Sign up at https://resend.com — free tier sends 3,000 emails/month.
# Required in production for order confirmation emails.
# If absent in dev, emails are skipped and logged to the console instead.
RESEND_API_KEY=re_your-resend-api-key-here

# The verified "from" address. Must match a domain you've verified in Resend.
# Dev: you can use Resend's shared test address (onboarding@resend.dev)
# Prod: set up your own domain at https://resend.com/domains
FROM_EMAIL=CutHaven <orders@cuthaven.com>

# ── Stripe ──────────────────────────────────────────────────────────────────
# From https://dashboard.stripe.com/apikeys
# Use sk_test_... for development, sk_live_... for production.

# ⚠️  DEPRECATED: This is FALLBACK ONLY — used if payment_gateways table is empty.
# For production, configure via Admin Panel → /admin/payment-gateways instead.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here

# Required in PRODUCTION. Not required locally if you use the Stripe CLI.
#
# How to get it:
#   1. Go to https://dashboard.stripe.com/webhooks
#   2. Click "Add endpoint"
#   3. Endpoint URL: https://yourdomain.com/api/checkout/webhook
#   4. Events to listen for: payment_intent.succeeded, payment_intent.payment_failed
#   5. Copy the "Signing secret" (starts with whsec_)
#
# Local dev with Stripe CLI:
#   stripe listen --forward-to http://localhost:4000/api/checkout/webhook
#   (CLI will print a temporary whsec_ secret — paste it here for local testing)
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# ═══════════════════════════════════════════════════════════════════════════
# ℹ️  RECOMMENDED: Configure Payment Gateways via Admin Panel
# ═══════════════════════════════════════════════════════════════════════════
# Instead of using the env vars above, add payment gateways via:
#   http://localhost:8080/admin/payment-gateways (dev)
#   https://www.cuthaven.com/admin/payment-gateways (prod)
#
# Benefits:
# - Update keys without redeployment
# - Support multiple Stripe/PayPal accounts
# - Easy test/live mode switching
# - Admin can manage independently
# - Keys stored securely in database
# ═══════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════
# PRODUCTION DEPLOYMENT CHECKLIST
# ═══════════════════════════════════════════════════════════════════════════
# Before going live, confirm every item below:
#
# [ ] NODE_ENV=production
# [ ] FRONTEND_ORIGIN=https://www.cuthaven.com  (exact domain, no trailing slash)
# [ ] STORE_URL=https://www.cuthaven.com         (used in GMC feed product links)
# [ ] SUPABASE_URL points to production Supabase project
# [ ] SUPABASE_SERVICE_ROLE_KEY is the production service-role key
# [ ] RESEND_API_KEY=re_live_...  from https://resend.com/api-keys
# [ ] FROM_EMAIL=CutHaven <orders@cuthaven.com>  (domain verified in Resend)
# [ ] STRIPE_SECRET_KEY=sk_live_...  (live key, not test)
# [ ] STRIPE_WEBHOOK_SECRET=whsec_... from production webhook endpoint in Stripe Dashboard
# [ ] PAYPAL_CLIENT_ID=...  from https://developer.paypal.com (live app)
# [ ] PAYPAL_CLIENT_SECRET=...  from https://developer.paypal.com (live app)
# [ ] PAYPAL_MODE=live
# [ ] Stripe account payout currency set to USD (Dashboard > Settings > Bank accounts)
# [ ] cuthaven_db_schema.sql has been run on the production Supabase project
# [ ] RLS policies reviewed before exposing customer data
# [ ] Server runs behind HTTPS (TLS termination at reverse proxy / platform level)
# [ ] Backend is NOT publicly accessible on raw port — only via reverse proxy
# ═══════════════════════════════════════════════════════════════════════════
